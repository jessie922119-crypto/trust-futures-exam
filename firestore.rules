rules_version = '2';
// 每位使用者只能讀寫自己的同步資料：users/{自己的 uid}
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
